{
  "name": "finanzas",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "pnpm -r --workspace-concurrency=1 test",
    "build": "pnpm -r build",
    "db:start": "node scripts/db.mjs",
    "db:seed": "pnpm --filter @finanzas/api exec node prisma/seed.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:api": "pnpm --filter @finanzas/api start:dev",
    "dev:web": "pnpm --filter @finanzas/web dev",
    "dev:mobile": "pnpm --filter @finanzas/mobile dev",
    "build:mobile": "pnpm --filter @finanzas/domain build && pnpm --filter @finanzas/mobile build"
  },
  "pnpm": {
    "overrides": {
      "multer": "^2.5.0",
      "postcss": "^8.5.23",
      "sharp": "^0.35.5",
      "deepmerge-ts": "^8.0.2"
    }
  },
  "devDependencies": {
    "embedded-postgres": "18.4.0-beta.17",
    "typescript": "5.7.3"
  }
}
