{
  "name": "finanzas",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "pnpm -r --workspace-concurrency=1 test",
    "build": "pnpm -r build",
    "db:start": "node scripts/db.mjs",
    "dev:api": "pnpm --filter @finanzas/api start:dev",
    "dev:web": "pnpm --filter @finanzas/web dev"
  },
  "devDependencies": {
    "embedded-postgres": "18.4.0-beta.17",
    "typescript": "5.7.3"
  }
}
